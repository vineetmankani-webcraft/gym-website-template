# Local Pages Functions runtime. Copy to .env and fill locally; never commit secrets.
ADMIN_USERNAME=admin
# Generate with npm run admin:password. Keep the entire hash in single quotes.
ADMIN_PASSWORD_HASH=''
ADMIN_ENV=local
ADMIN_ORIGIN=http://localhost:8788
CONTENT_BRANCH=admin-preview/local
GITHUB_REPOSITORY=VineetMankani/gym-website-template
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PKCS8 private key; use escaped newlines in this local value.
GITHUB_PRIVATE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=
CLOUDFLARE_API_TOKEN=
# Public configuration: safe to include in the browser/build.
NEXT_PUBLIC_SITE_URL=https://your-gym.example
NEXT_PUBLIC_ADMIN_URL=https://your-gym.example/admin
