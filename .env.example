# Copy to .env for local use. Set the same server-side values in Cloudflare Pages.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
GITHUB_REPOSITORY=VineetMankani/gym-website-template
GITHUB_TOKEN=
# Optional locally. Cloudflare automatically supplies CF_PAGES_BRANCH.
CONTENT_BRANCH=feature/admin-portal
# Public configuration: safe to include in the browser/build.
NEXT_PUBLIC_SITE_URL=https://your-gym.example
NEXT_PUBLIC_ADMIN_URL=https://your-gym.example/admin
